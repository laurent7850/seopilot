# Database
DATABASE_URL="postgresql://seopilot:password@localhost:5432/seopilot"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# AI Provider (OpenRouter recommande, ou OpenAI)
OPENROUTER_API_KEY="sk-or-your-openrouter-key"
# OPENAI_API_KEY="sk-your-openai-key"
# ANTHROPIC_API_KEY="sk-ant-your-key"
# MISTRAL_API_KEY="your-mistral-key"
# GEMINI_API_KEY="your-gemini-key"
# Forcer un provider / modele (sinon auto-detection dans l'ordre ci-dessus)
# LLM_PROVIDER="openrouter"
# LLM_MODEL="openai/gpt-4o"

# Redis
REDIS_URL="redis://localhost:6379"

# SMTP (optionnel - pour les notifications email)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="noreply@seopilot.fr"

# Unsplash API (free - get key at https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY="your-unsplash-access-key"

# Google PageSpeed Insights (gratuit - console.cloud.google.com)
# Sans cette cle : audit technique sans score de performance ni Core Web Vitals
GOOGLE_PSI_API_KEY="your-pagespeed-api-key"

# Google OAuth - Search Console & Analytics
# Sans ces cles : impossible de connecter GSC/GA4, donc pas de positions reelles
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Webhook n8n (secret partage - l'endpoint rejette tout si absent)
N8N_WEBHOOK_SECRET="generate-a-long-random-secret"

# DataForSEO (optionnel, payant) - volumes de recherche et SERP reels
# Sans ces cles : volumes et difficultes ESTIMES par IA, non mesures
DATAFORSEO_LOGIN="your-dataforseo-login"
DATAFORSEO_PASSWORD="your-dataforseo-password"

# App
NEXT_PUBLIC_APP_NAME="SEOPilot"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Docker deployment
DB_PASSWORD="change-me-strong-password"
DOMAIN="your-domain.com"
EMAIL="your-email@example.com"
